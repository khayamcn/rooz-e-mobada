# ────────────────────────────────────────────────────────────
# Rooz-e Mobada — Firebase Environment Variables Example
# ────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in real values from Firebase Console.
# NEVER commit `.env.local` to version control.

# ── Firebase (Client SDK) ────────────────────────────────
# Find these in: Firebase Console → Project Settings → Your Apps → Web App
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Firebase Admin SDK (SERVER ONLY) ─────────────────────
# Find these in: Firebase Console → Project Settings → Service Accounts
# Used by Cloud Functions and admin scripts.
# NEVER expose these in client code.
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-key-here\n-----END PRIVATE KEY-----\n"

# ── App Check ─────────────────────────────────────────────
# Web: reCAPTCHA Enterprise site key
NEXT_PUBLIC_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=your-recaptcha-site-key
# Android: Play Integrity API
ANDROID_PLAY_INTEGRITY_PROJECT_NUMBER=1234567890

# ── SMS OTP (Phone Auth) ───────────────────────────────────
# Firebase Phone Auth needs a verified phone number for testing in production
# For Iranian numbers, you may need a custom SMS provider (kavenegar/farazsms)
# via Cloud Functions.
KAVENEGAR_API_KEY=your-kavenegar-api-key
KAVENEGAR_SENDER=1000596446
OTP_TEMPLATE=rooz-otp

# ── Google Sign-In ─────────────────────────────────────────
# Web OAuth client ID (for Credential Manager)
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ── Storage Limits ───────────────────────────────────────
DEFAULT_FAMILY_QUOTA_BYTES=1073741824
MAX_FILE_SIZE_BYTES=10485760
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,application/pdf,audio/mpeg,video/mp4,application/zip

# ── Invitation Code ───────────────────────────────────────
INVITE_CODE_LENGTH=6
INVITE_EXPIRES_IN_DAYS=7
INVITE_MAX_USES=5

# ── Trash Retention ───────────────────────────────────────
TRASH_RETENTION_DAYS=30

# ── App Version ───────────────────────────────────────────
NEXT_PUBLIC_APP_VERSION=1.3.0
NEXT_PUBLIC_UPDATE_CHECK_URL=https://api.yourdomain.com/rooz/version

# ── Analytics (optional) ─────────────────────────────────
# Firebase Analytics is enabled by default with measurementId above
# Crashlytics needs Android-specific setup (not in web build)
