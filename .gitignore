# ──────────────────────────────────────────────────────────────
# Rooz-e Mobada — .gitignore
# ──────────────────────────────────────────────────────────────

# Dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js build output
/.next/
/out/
/build

# Misc system files
.DS_Store
*.pem
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
dev.log
dev.out.log
server.log

# Environment variables — NEVER commit real secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow the example template to be committed
!.env.example

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# Local-only files
local-*
.claude
.z-ai-config
.zscripts/

# Build artifacts
dist/
standalone/

# Internal skill/runtime files (not part of the app)
/skills/
/tool-results/
/upload/
/db/

# Mini-services and examples (kept internal)
/mini-services/
/examples/
/tests/

# Screenshots (kept in releases, not in repo main)
/download/*.png
/download/*.jpg
/download/*.webp
/download/*.webm

# Project prompts
prompt

# PWA generated icons (regenerated from SVG source)
/public/icon-192.png
/public/icon-512.png

# Capacitor Android build
/android/
/capacitor.config.ts

# Keystore — NEVER commit (contains signing keys)
*.keystore
*.jks
keystore.properties
download/apk/*.keystore
download/apk/*.jks

# APK / AAB files (use GitHub Releases instead)
*.apk
*.aab
download/apk/*.apk
download/apk/*.aab
# But keep the README
!download/apk/README.md
!download/apk/README-v1.5.0.md
